GAMES_ORIGIN=http://localhost:4000

# Server-only. Never prefix database URLs with NEXT_PUBLIC_.
MOYUFUN_WEB_DATABASE_URL=postgresql://moyufun_web.<project-ref>:<password>@<pooler-host>:6543/postgres

# Bearer token for POST /api/revalidate/games. Use a long random value.
MOYUFUN_REVALIDATE_SECRET=<random-secret>

# HTTP Basic Auth password for /stats. Server-only, random, and at least 32 characters.
MOYUFUN_STATS_PASSWORD=<random-secret-at-least-32-characters>

# Publishing environment only. Do not add this value to the Vercel web runtime.
MOYUFUN_PUBLISH_DATABASE_URL=postgresql://moyufun_publisher.<project-ref>:<password>@<pooler-host>:5432/postgres
